{
  "info": {
    "name": "7주차 회원 관리 REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "memberId",
      "value": "3"
    }
  ],
  "item": [
    {
      "name": "1. 첫 API (누구나) GET /api/hello",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hello",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hello"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "2. 내 정보 - 인증 없음 → 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "me"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "3. 내 정보 - student1 → 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "me"
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "student1",
              "type": "string"
            },
            {
              "key": "password",
              "value": "1234",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "4. 회원 목록 (admin) → 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/admin/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "members"
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "admin",
              "type": "string"
            },
            {
              "key": "password",
              "value": "1234",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "4-1. 회원 검색 ?keyword=student (연습문제 ①)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/admin/members?keyword=student",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "members"
          ],
          "query": [
            {
              "key": "keyword",
              "value": "student"
            }
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "admin",
              "type": "string"
            },
            {
              "key": "password",
              "value": "1234",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "5. 회원 1명 → 200 / 없는 번호 9999 → 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/admin/members/{{memberId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "members",
            "{{memberId}}"
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "admin",
              "type": "string"
            },
            {
              "key": "password",
              "value": "1234",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "6. 회원 목록 (student1) → 403",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/admin/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "members"
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "student1",
              "type": "string"
            },
            {
              "key": "password",
              "value": "1234",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "7. 회원 등록 → 201 (한 번 더 → 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "members"
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "admin",
              "type": "string"
            },
            {
              "key": "password",
              "value": "1234",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"postman1\",\n  \"password\": \"1234\",\n  \"passwordConfirm\": \"1234\",\n  \"name\": \"포스트맨\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "8. 권한 변경 ADMIN → 200",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/members/{{memberId}}/role",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "members",
            "{{memberId}}",
            "role"
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "admin",
              "type": "string"
            },
            {
              "key": "password",
              "value": "1234",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"ADMIN\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "9. 권한 변경 SUPER → 400",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/members/{{memberId}}/role",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "members",
            "{{memberId}}",
            "role"
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "admin",
              "type": "string"
            },
            {
              "key": "password",
              "value": "1234",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"SUPER\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10. 회원 삭제 (student1) → 403",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/admin/members/{{memberId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "members",
            "{{memberId}}"
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "student1",
              "type": "string"
            },
            {
              "key": "password",
              "value": "1234",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "11. 회원 삭제 (admin) → 204",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/admin/members/{{memberId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "members",
            "{{memberId}}"
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "admin",
              "type": "string"
            },
            {
              "key": "password",
              "value": "1234",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}